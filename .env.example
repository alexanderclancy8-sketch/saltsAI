# Copy to .env and fill in what you have. Anything left blank runs on demo data.
# NEVER commit .env - it holds passwords and keys.

# --- You ---------------------------------------------------------------------
OWNER_NAME=Alex
OWNER_SALUTATION=sir
OWNER_EMAIL=you@saltsfireandsecurity.co.uk
PARTNER_NAME=
PARTNER_EMAIL=
# Microsoft 365 accounts allowed in through Azure sign-in - set by `bash infra/deploy.sh signin ...`
# MANAGER_EMAILS=
PUBLIC_BASE_URL=http://localhost:8000
# Private facts for Jarvis's notes from day one, separated by | e.g.
# JARVIS_NOTES=<answering service> handle our out-of-hours; reports arrive in info@ early morning|...
JARVIS_NOTES=

# --- Security (required once Jarvis is reachable from the internet) ------------
JARVIS_OWNER_PASSWORD=
JARVIS_SECRET_KEY=change-me-to-a-long-random-string
STAFF_REPORT_KEY=            # staff use /report?key=<this>

# --- Claude (the brain) ----------------------------------------------------------
# Option A - your Claude Max/Pro subscription (no API credits): run `claude setup-token`
# on your own computer and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Option B - pay-as-you-go Claude API key (console.anthropic.com). Leave blank for option A.
ANTHROPIC_API_KEY=
LLM_BACKEND=auto             # auto | max | api
JARVIS_MODEL=claude-opus-5-5
VOICE_EFFORT=low               # low | medium | high - lower replies faster
CHAT_EFFORT=medium

# --- Microsoft 365: Outlook + Teams ----------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=you@saltsfireandsecurity.co.uk
TEAMS_WEBHOOK_URL=
ISSUE_EMAIL_TAG=[ISSUE]
OOH_EMAIL_FROM=              # your out-of-hours / alarm monitoring centre's email address or domain
OOH_SUBJECT_KEYWORD=out of hours
OOH_MAILBOX=                 # where the reports arrive, e.g. info@saltsfireandsecurity.co.uk (include it in the access policy)

# --- Salts FSM -----------------------------------------------------------------------
FSM_BASE_URL=                # e.g. https://<your-fsm>.azurewebsites.net
FSM_API_PREFIX=/api
FSM_API_KEY=
FSM_API_KEY_HEADER=Authorization

# --- GitHub (FSM source code + auto-fix) ------------------------------------------------
GITHUB_TOKEN=                # fine-grained token: contents, pull requests, issues, actions (read/write) on the FSM repo
FSM_REPO=                    # owner/repo
FSM_DEFAULT_BRANCH=main
FSM_DEPLOY_WORKFLOW=deploy-azure.yml
FIXER_MODE=builtin           # builtin | claude_action | off

# --- Azure ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_DEPLOY_MODE=github     # github | kudu
AZURE_FSM_SCM_URL=           # https://<fsm-app>-<hash>.scm.uksouth-01.azurewebsites.net (kudu mode)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Accounts: Sage --------------------------------------------------------------------------
SAGE_CLIENT_ID=              # Sage Accounting (cloud) app from developerselfservice.sageone.com
SAGE_CLIENT_SECRET=
SAGE_WRITE_ENABLED=false     # true lets Jarvis create invoices you approve
SAGE_SALES_NOMINAL_CODE=4000
# Sage 50 desktop instead? Put CSV exports in ./finance_data (see README).
FINANCIAL_YEAR_END=03-31
VAT_QUARTER_END_MONTHS=3,6,9,12
VAT_SCHEME=invoice
ASSOCIATED_COMPANIES=0
MONTHLY_PAYROLL_ESTIMATE=0
MONTHLY_OVERHEADS_ESTIMATE=0
BOE_BASE_RATE=4.0

# --- RAM Tracking ------------------------------------------------------------------------------
RAM_API_BASE_URL=
RAM_API_KEY=
RAM_API_KEY_HEADER=X-Api-Key

# --- Voice ---------------------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=daniel       # daniel | george | alice | lily | or any ElevenLabs voice id
ELEVENLABS_MODEL=eleven_multilingual_v2   # eleven_flash_v2_5 is a little faster, less natural
DEEPGRAM_API_KEY=
STT_LANGUAGE=en-GB
OPENAI_API_KEY=               # only for Whisper speech-to-text
AZURE_SPEECH_KEY=             # optional alternative voice (en-GB-RyanNeural)
AZURE_SPEECH_REGION=uksouth
WAKE_WORD=jarvis

# --- Marketing ------------------------------------------------------------------------------------
WEBSITE_URL=https://www.saltsfireandsecurity.co.uk
GOOGLE_REVIEW_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
SEARCH_CONSOLE_SITE=sc-domain:saltsfireandsecurity.co.uk
PAGESPEED_API_KEY=
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_BUSINESS_ID=
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
