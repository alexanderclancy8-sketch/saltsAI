{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "__BOT_APP_ID__",
  "developer": {
    "name": "__COMPANY_NAME__",
    "websiteUrl": "__WEBSITE_URL__",
    "privacyUrl": "__WEBSITE_URL__",
    "termsOfUseUrl": "__WEBSITE_URL__"
  },
  "name": {
    "short": "Jarvis",
    "full": "Jarvis - __COMPANY_NAME__"
  },
  "description": {
    "short": "Your company AI assistant.",
    "full": "Message Jarvis the same way you'd message a colleague. It reads your email, knows Salts FSM inside out, keeps an eye on the accounts and the team, and gets things done once you approve them."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4C8DFF",
  "bots": [
    {
      "botId": "__BOT_APP_ID__",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": []
}
